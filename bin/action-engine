#!/usr/bin/env sh
# Phase 15 design contract: capability-gated action planning with fixed schemas.
# This file never writes hardware controls, /proc, /sys, Android properties, games, or arbitrary paths.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
APP_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
AXGO_ROOT="${AXGO_ROOT:-$APP_ROOT/AX-T615-GAME-OPTIMIZER}"
AXGO_DATA_ROOT="${AXGO_DATA_ROOT:-$AXGO_ROOT}"
POLICY_ENGINE="$APP_ROOT/bin/policy-engine"
ACTION_RUNTIME_DIR="${VEGAS_ACTION_RUNTIME_DIR:-$AXGO_DATA_ROOT/runtime/controlled-actions}"
ACTION_AUDIT_FILE="$ACTION_RUNTIME_DIR/audit.log"
ACTION_LOCK_FILE="$ACTION_RUNTIME_DIR/action-lock.state"
MAX_AUDIT_RECORDS=16

usage() {
    cat <<'EOF'
Usage: action-engine {status|snapshot|capabilities|plan <action-id>|validate <action-id>|dry-run <action-id>|apply <action-id> --dry-run|verify <action-id>|rollback <action-id>|history|lock|unlock --explicit-unlock}

Fixed capability-gated action architecture. Every public apply route is dry-run only.
Unverified device controls are UNSUPPORTED and no hardware, process, network, game,
/proc, /sys, Android-property, root, arbitrary command, or arbitrary path action exists.
EOF
}

now() { date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || printf '%s' 'unknown-time'; }

escape() { printf '%s' "$1" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

key_value() {
    KEY="$1"; DATA="$2"
    VALUE=$(printf '%s\n' "$DATA" | awk -F= -v key="$KEY" '$1 == key { value=$0; sub(/^[^=]*=/, "", value); print value }' | tail -n 1)
    [ -n "$VALUE" ] && printf '%s' "$VALUE" || printf '%s' 'UNKNOWN'
}

json_value() {
    KEY="$1"; DATA="$2"
    VALUE=$(printf '%s' "$DATA" | sed -n "s/.*\"$KEY\":\"\([^\"]*\)\".*/\1/p" | head -n 1)
    [ -n "$VALUE" ] && printf '%s' "$VALUE" || printf '%s' 'UNKNOWN'
}

ensure_runtime() { umask 077; mkdir -p "$ACTION_RUNTIME_DIR" 2>/dev/null; }
read_file() { [ -r "$1" ] && cat "$1" 2>/dev/null || :; }

write_file() {
    ensure_runtime || return 1
    TEMP_FILE="$1.tmp.$$"
    printf '%s\n' "$2" > "$TEMP_FILE" 2>/dev/null || return 1
    mv -f "$TEMP_FILE" "$1" 2>/dev/null
}

action_lock_state() {
    VALUE=$(read_file "$ACTION_LOCK_FILE")
    case "$VALUE" in ENABLED|DISABLED) printf '%s' "$VALUE" ;; *) printf '%s' 'ENABLED' ;; esac
}

allowed_action() {
    case "$1" in
        refresh_telemetry|profile_balanced_advisory|profile_performance_advisory|thermal_protection_advisory|memory_conservative_advisory|battery_conservative_advisory) return 0 ;;
        *) return 1 ;;
    esac
}

action_type() {
    case "$1" in
        refresh_telemetry) printf '%s' 'READ_ONLY_OBSERVATION' ;;
        profile_balanced_advisory|profile_performance_advisory) printf '%s' 'PROFILE_POLICY_ADVISORY' ;;
        thermal_protection_advisory) printf '%s' 'THERMAL_PROTECTION_ADVISORY' ;;
        memory_conservative_advisory) printf '%s' 'MEMORY_SAFETY_ADVISORY' ;;
        battery_conservative_advisory) printf '%s' 'BATTERY_SAFETY_ADVISORY' ;;
        *) printf '%s' 'UNKNOWN' ;;
    esac
}

action_target() {
    case "$1" in
        refresh_telemetry) printf '%s' 'vegas-inject-evidence-snapshot' ;;
        profile_balanced_advisory|profile_performance_advisory) printf '%s' 'vegas-inject-profile-policy' ;;
        thermal_protection_advisory) printf '%s' 'vegas-inject-thermal-policy' ;;
        memory_conservative_advisory) printf '%s' 'vegas-inject-memory-policy' ;;
        battery_conservative_advisory) printf '%s' 'vegas-inject-battery-policy' ;;
        *) printf '%s' 'UNKNOWN' ;;
    esac
}

action_purpose() {
    case "$1" in
        refresh_telemetry) printf '%s' 'request a bounded read-only telemetry observation' ;;
        profile_balanced_advisory) printf '%s' 'record the existing balanced-profile recommendation without changing a game or device setting' ;;
        profile_performance_advisory) printf '%s' 'record a performance-profile advisory; capability is not verified on this device' ;;
        thermal_protection_advisory) printf '%s' 'record a thermal-safety advisory; thermal control is not exposed' ;;
        memory_conservative_advisory) printf '%s' 'record a memory-safety advisory; memory subsystem control is not exposed' ;;
        battery_conservative_advisory) printf '%s' 'record a battery-safety advisory; battery or charging control is not exposed' ;;
        *) printf '%s' 'UNKNOWN' ;;
    esac
}

action_policy_states() {
    case "$1" in
        refresh_telemetry) printf '%s' 'SAFE,BALANCED,CONSERVATIVE,PERFORMANCE_ADVISORY,COOL_ADVISORY,BATTERY_ADVISORY' ;;
        profile_balanced_advisory) printf '%s' 'SAFE,BALANCED,CONSERVATIVE,COOL_ADVISORY,BATTERY_ADVISORY' ;;
        profile_performance_advisory) printf '%s' 'PERFORMANCE_ADVISORY' ;;
        thermal_protection_advisory|memory_conservative_advisory) printf '%s' 'SAFETY_BLOCKED,CONSERVATIVE' ;;
        battery_conservative_advisory) printf '%s' 'BATTERY_ADVISORY,CONSERVATIVE' ;;
        *) printf '%s' 'NONE' ;;
    esac
}

capability_state() {
    case "$1" in
        refresh_telemetry) printf '%s' 'SUPPORTED_READ_ONLY' ;;
        profile_balanced_advisory) printf '%s' 'SUPPORTED_POLICY_RECORD_ONLY' ;;
        profile_performance_advisory|thermal_protection_advisory|memory_conservative_advisory|battery_conservative_advisory) printf '%s' 'UNSUPPORTED_DEVICE_CAPABILITY_UNVERIFIED' ;;
        *) printf '%s' 'UNKNOWN' ;;
    esac
}

is_dry_run_executable() {
    case "$1" in refresh_telemetry|profile_balanced_advisory) return 0 ;; *) return 1 ;; esac
}

in_csv() { printf '%s\n' ",$1," | grep -Fq ",$2,"; }

blocked_action_registry() {
    cat <<'EOF'
HARDWARE_WRITES=BLOCKED
CPU_CONTROLS=BLOCKED
GPU_CONTROLS=BLOCKED
THERMAL_CONTROLS=BLOCKED
BATTERY_CONTROLS=BLOCKED
CHARGING_CONTROLS=BLOCKED
POWER_HAL_CONTROLS=BLOCKED
PROCESS_CONTROLS=BLOCKED
MEMORY_SUBSYSTEM_CONTROLS=BLOCKED
PROC_FILESYSTEM=BLOCKED
SYS_FILESYSTEM=BLOCKED
ANDROID_PROPERTIES=BLOCKED
ROOT_ESCALATION=BLOCKED
ARBITRARY_SHELL=BLOCKED
ARBITRARY_EXECUTABLE_PATHS=BLOCKED
NETWORK_EXECUTION=BLOCKED
PLUGIN_DEFINED_COMMANDS=BLOCKED
EOF
}

is_blocked_identifier() {
    case "$1" in
        *cpu*|*gpu*|*governor*|*frequency*|*thermal*control*|*battery*control*|*charging*|*power_hal*|*process*|*force-stop*|*kill*|*zram*|*swap*|*lmkd*|*proc*|*sys*|*property*|*shell*|*exec*|*network*|*root*) return 0 ;;
        *) return 1 ;;
    esac
}

policy_snapshot() {
    OUTPUT=$(AXGO_ROOT="$AXGO_ROOT" AXGO_DATA_ROOT="$AXGO_DATA_ROOT" ORCH_EVIDENCE_FILE="${ORCH_EVIDENCE_FILE:-}" sh "$POLICY_ENGINE" snapshot 2>/dev/null || :)
    [ -n "$OUTPUT" ] && printf '%s' "$OUTPUT" || printf '%s' '{"source":"unavailable","policy_state":"INSUFFICIENT_EVIDENCE","recommendation":"remain_conservative","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","safety_classification":"READ_ONLY_CONSERVATIVE_FALLBACK","provenance":"unavailable"}'
}

load_context() {
    POLICY=$(policy_snapshot)
    POLICY_STATE=$(json_value policy_state "$POLICY")
    RECOMMENDATION=$(json_value recommendation "$POLICY")
    CONFIDENCE=$(json_value confidence "$POLICY")
    EVIDENCE_QUALITY=$(json_value evidence_quality "$POLICY")
    SAFETY_CLASSIFICATION=$(json_value safety_classification "$POLICY")
    PROVENANCE=$(json_value provenance "$POLICY")
}

context_validation() {
    ACTION_ID="$1"
    load_context
    VALIDATION_RESULT=DENIED
    VALIDATION_REASON='unknown validation error'
    allowed_action "$ACTION_ID" || { VALIDATION_REASON='unknown action identifier'; return 1; }
    is_blocked_identifier "$ACTION_ID" && { VALIDATION_REASON='blocked action category'; return 1; }
    CAPABILITY=$(capability_state "$ACTION_ID")
    case "$CAPABILITY" in
        UNSUPPORTED_*|UNKNOWN) VALIDATION_REASON="capability state $CAPABILITY does not authorize this action"; return 1 ;;
    esac
    case "$EVIDENCE_QUALITY" in UNKNOWN|UNSAFE_UNKNOWN|STALE|INVALID|UNAVAILABLE|'') VALIDATION_REASON="evidence quality $EVIDENCE_QUALITY is not actionable"; return 1 ;; esac
    case "$SAFETY_CLASSIFICATION" in READ_ONLY_ADVISORY|READ_ONLY_CONSERVATIVE) : ;; *) VALIDATION_REASON="safety classification $SAFETY_CLASSIFICATION denies action planning"; return 1 ;; esac
    in_csv "$(action_policy_states "$ACTION_ID")" "$POLICY_STATE" || { VALIDATION_REASON="policy state $POLICY_STATE is not permitted for $ACTION_ID"; return 1; }
    case "$CONFIDENCE" in HIGH|MEDIUM|LOW) : ;; *) VALIDATION_REASON='policy confidence is unavailable'; return 1 ;; esac
    VALIDATION_RESULT=VALID
    VALIDATION_REASON='fixed action ID, detected capability, evidence quality, policy state, safety classification, bounded parameters, and no-device-write contract validated'
    return 0
}

append_audit() {
    ensure_runtime || return 1
    RECORD="$1"; TEMP_AUDIT="$ACTION_AUDIT_FILE.tmp.$$"
    { [ -r "$ACTION_AUDIT_FILE" ] && tail -n "$MAX_AUDIT_RECORDS" "$ACTION_AUDIT_FILE" 2>/dev/null || :; printf '%s\n' "$RECORD"; } > "$TEMP_AUDIT" 2>/dev/null || return 1
    tail -n "$MAX_AUDIT_RECORDS" "$TEMP_AUDIT" > "$ACTION_AUDIT_FILE" 2>/dev/null && rm -f "$TEMP_AUDIT" 2>/dev/null
}

audit_record() {
    printf 'ACTION_AUDIT|timestamp=%s|action_id=%s|mode=%s|capability=%s|policy_state=%s|evidence_quality=%s|validation_result=%s|execution_result=%s|verification_result=%s|rollback_result=%s|reason=%s|provenance=%s|personal_data=NO|network_transmission=NO|hardware_changed=NO' \
        "$(now)" "$1" "$2" "$(capability_state "$1")" "$POLICY_STATE" "$EVIDENCE_QUALITY" "$3" "$4" "$5" "$6" "$(escape "$7")" "$(escape "$PROVENANCE")"
}

emit_action_record() {
    ACTION_ID="$1"; MODE="$2"; RESULT="$3"; DRY_RUN="$4"; VERIFICATION="$5"; ROLLBACK="$6"
    printf 'ACTION_ID=%s\n' "$ACTION_ID"
    printf 'ACTION_TYPE=%s\n' "$(action_type "$ACTION_ID")"
    printf 'TARGET=%s\n' "$(action_target "$ACTION_ID")"
    printf 'PURPOSE=%s\n' "$(action_purpose "$ACTION_ID")"
    printf 'CAPABILITY_STATE=%s\n' "$(capability_state "$ACTION_ID")"
    printf 'REQUESTED_BY=vegas-inject-fixed-control-plane\n'
    printf 'POLICY_STATE=%s\nEVIDENCE_QUALITY=%s\nCONFIDENCE=%s\nSAFETY_CLASSIFICATION=%s\n' "$POLICY_STATE" "$EVIDENCE_QUALITY" "$CONFIDENCE" "$SAFETY_CLASSIFICATION"
    printf 'PRECONDITIONS=%s\nVALIDATION_RESULT=%s\nVALIDATION_REASON=%s\n' "$(action_policy_states "$ACTION_ID")" "$VALIDATION_RESULT" "$VALIDATION_REASON"
    printf 'DRY_RUN=%s\nMODE=%s\nRESULT=%s\nVERIFICATION_RESULT=%s\nROLLBACK_RESULT=%s\n' "$DRY_RUN" "$MODE" "$RESULT" "$VERIFICATION" "$ROLLBACK"
    printf 'CREATED_AT=%s\nPROVENANCE=%s\nACTION_LOCK=%s\n' "$(now)" "$PROVENANCE" "$(action_lock_state)"
    printf 'HARDWARE_WRITES=NO\nPROCESS_CONTROL=NO\nNETWORK_EXECUTION=NO\nARBITRARY_EXECUTION=NO\nDEVICE_ACTION_EXECUTION=NOT_AVAILABLE\n'
}

plan_action() {
    ACTION_ID="$1"
    context_validation "$ACTION_ID" || { emit_action_record "$ACTION_ID" PLAN ACTION_DENIED YES NOT_APPLICABLE NOT_APPLICABLE; return 1; }
    emit_action_record "$ACTION_ID" PLAN PLANNED YES NOT_APPLICABLE NOT_APPLICABLE
}

validate_action() {
    ACTION_ID="$1"; context_validation "$ACTION_ID" || :
    emit_action_record "$ACTION_ID" VALIDATE "${VALIDATION_RESULT}_ONLY" YES NOT_APPLICABLE NOT_APPLICABLE
    [ "$VALIDATION_RESULT" = VALID ]
}

dry_run_action() {
    ACTION_ID="$1"; context_validation "$ACTION_ID" || :
    if [ "$VALIDATION_RESULT" = VALID ] && is_dry_run_executable "$ACTION_ID"; then
        RESULT=DRY_RUN_VALIDATED
    elif [ "$VALIDATION_RESULT" = VALID ]; then
        RESULT=DRY_RUN_UNSUPPORTED_DEVICE_CAPABILITY
    else
        RESULT=ACTION_DENIED
    fi
    append_audit "$(audit_record "$ACTION_ID" DRY_RUN "$VALIDATION_RESULT" "$RESULT" NOT_APPLICABLE NOT_APPLICABLE "$VALIDATION_REASON")" || :
    emit_action_record "$ACTION_ID" DRY_RUN "$RESULT" YES NOT_APPLICABLE NOT_APPLICABLE
    [ "$RESULT" = DRY_RUN_VALIDATED ]
}

apply_action() {
    ACTION_ID="$1"; INTENT="${2:-}"
    [ "$INTENT" = --dry-run ] || { printf 'ACTION_DENIED=REAL_DEVICE_APPLY_NOT_AVAILABLE\nMODE=DRY_RUN\nHARDWARE_WRITES=NO\n'; return 1; }
    dry_run_action "$ACTION_ID"
}

verify_action() {
    ACTION_ID="$1"; allowed_action "$ACTION_ID" || { printf 'VERIFICATION_DENIED=UNKNOWN_ACTION_ID\n'; return 1; }
    load_context
    VALIDATION_RESULT=NOT_APPLICABLE
    VALIDATION_REASON='no real device action exists to verify'
    append_audit "$(audit_record "$ACTION_ID" VERIFY NOT_APPLICABLE NOT_APPLIED NOT_APPLICABLE NOT_APPLICABLE 'no real device action exists to verify')" || :
    emit_action_record "$ACTION_ID" VERIFY NOT_APPLIED YES NOT_APPLICABLE NOT_APPLICABLE
}

rollback_action() {
    ACTION_ID="$1"; allowed_action "$ACTION_ID" || { printf 'ROLLBACK_DENIED=UNKNOWN_ACTION_ID\n'; return 1; }
    load_context
    VALIDATION_RESULT=NOT_APPLICABLE
    VALIDATION_REASON='no real device action exists to roll back'
    append_audit "$(audit_record "$ACTION_ID" ROLLBACK NOT_APPLICABLE NOT_APPLIED NOT_APPLICABLE NO_APPLIED_ACTION 'no real device action exists to roll back')" || :
    emit_action_record "$ACTION_ID" ROLLBACK NOT_APPLIED YES NOT_APPLICABLE NO_APPLIED_ACTION
}

status() {
    load_context
    HISTORY_COUNT=0; [ -r "$ACTION_AUDIT_FILE" ] && HISTORY_COUNT=$(awk 'END { print NR + 0 }' "$ACTION_AUDIT_FILE" 2>/dev/null); [ -n "$HISTORY_COUNT" ] || HISTORY_COUNT=0
    printf 'VEGAS-INJECT CAPABILITY-GATED ACTIONS\n'
    printf 'MODE=DRY_RUN\nACTION_LOCK=%s\nDEFAULT_ACTION_MODE=DRY_RUN\nREAL_DEVICE_APPLY=NOT_AVAILABLE\n' "$(action_lock_state)"
    printf 'CURRENT_RECOMMENDATION=%s\nPOLICY_STATE=%s\nEVIDENCE_QUALITY=%s\nCONFIDENCE=%s\nSAFETY_CLASSIFICATION=%s\n' "$RECOMMENDATION" "$POLICY_STATE" "$EVIDENCE_QUALITY" "$CONFIDENCE" "$SAFETY_CLASSIFICATION"
    printf 'PLANNED_ACTION=refresh_telemetry\nVALIDATION_STATUS=REQUIRED\n'
    printf 'AVAILABLE_ACTIONS=refresh_telemetry,profile_balanced_advisory\nUNSUPPORTED_ACTIONS=profile_performance_advisory,thermal_protection_advisory,memory_conservative_advisory,battery_conservative_advisory\n'
    printf 'BLOCKED_ACTIONS=hardware,cpu,gpu,governor,frequency,thermal_control,battery_control,charging,power_hal,process,memory_subsystem,proc,sys,android_properties,root,shell,arbitrary_path,network,plugin_commands\n'
    printf 'ROLLBACK_AVAILABLE=NO_APPLIED_DEVICE_ACTIONS\nAUDIT_HISTORY_COUNT=%s\nAUDIT_HISTORY_MAX=%s\n' "$HISTORY_COUNT" "$MAX_AUDIT_RECORDS"
    printf 'CONCURRENCY_LOCK=NOT_REQUIRED_FOR_DRY_RUN\nHARDWARE_WRITES=NO\nPROCESS_CONTROL=NO\nNETWORK_EXECUTION=NO\nARBITRARY_EXECUTION=NO\n'
    printf 'ACTION_LAYER_SCOPE=FIXED_CAPABILITY_GATED_DRY_RUN_ONLY\nDEVICE_CAPABILITIES=UNVERIFIED\nSAFETY_GATE=ENFORCED\n'
}

snapshot() {
    load_context
    HISTORY_COUNT=0; [ -r "$ACTION_AUDIT_FILE" ] && HISTORY_COUNT=$(awk 'END { print NR + 0 }' "$ACTION_AUDIT_FILE" 2>/dev/null); [ -n "$HISTORY_COUNT" ] || HISTORY_COUNT=0
    printf '{'
    printf '"schema":"1","component":"vegas-capability-gated-action-engine",'
    printf '"source":"vegas-inject-fixed-action-engine",'
    printf '"read_only":true,"mode":"DRY_RUN","action_lock":"%s",' "$(escape "$(action_lock_state)")"
    printf '"real_device_apply":"NOT_AVAILABLE","device_capabilities":"UNVERIFIED","safety_gate":"ENFORCED",'
    printf '"current_recommendation":"%s","policy_state":"%s","evidence_quality":"%s","confidence":"%s",' \
        "$(escape "$RECOMMENDATION")" "$(escape "$POLICY_STATE")" "$(escape "$EVIDENCE_QUALITY")" "$(escape "$CONFIDENCE")"
    printf '"planned_action":"refresh_telemetry","validation_status":"REQUIRED",'
    printf '"available_actions":"refresh_telemetry,profile_balanced_advisory",'
    printf '"unsupported_actions":"profile_performance_advisory,thermal_protection_advisory,memory_conservative_advisory,battery_conservative_advisory",'
    printf '"blocked_actions":"hardware,cpu,gpu,governor,frequency,thermal_control,battery_control,charging,power_hal,process,memory_subsystem,proc,sys,android_properties,root,shell,arbitrary_path,network,plugin_commands",'
    printf '"rollback_available":"NO_APPLIED_DEVICE_ACTIONS",'
    printf '"audit_history":{"count":%s,"maximum":%s,"bounded":true,"repository_local":true},' "$HISTORY_COUNT" "$MAX_AUDIT_RECORDS"
    printf '"safety":{"hardware_writes":false,"process_control":false,"network_execution":false,"arbitrary_execution":false,"device_action_execution":"NOT_AVAILABLE","browser_execution":false}'
    printf '}\n'
}

capabilities() {
    cat <<'EOF'
VEGAS-INJECT CAPABILITY-GATED ACTION CAPABILITIES
MODE=DRY_RUN
ACTION_LOCK=ENABLED_BY_DEFAULT
OPERATIONS=status,capabilities,plan,validate,dry-run,apply--dry-run,verify,rollback,history,lock,unlock
FIXED_ACTIONS=refresh_telemetry,profile_balanced_advisory,profile_performance_advisory,thermal_protection_advisory,memory_conservative_advisory,battery_conservative_advisory
SUPPORTED_ACTIONS=refresh_telemetry,profile_balanced_advisory
UNSUPPORTED_DEVICE_ACTIONS=profile_performance_advisory,thermal_protection_advisory,memory_conservative_advisory,battery_conservative_advisory
REAL_DEVICE_APPLY=NOT_AVAILABLE
ROLLBACK=NO_APPLIED_DEVICE_ACTIONS
AUDIT_HISTORY=BOUNDED_LOCAL_ONLY
EOF
    blocked_action_registry
}

history() {
    printf 'ACTION_AUDIT_HISTORY\nMAX_RECORDS=%s\nPERSONAL_DATA=NO\nNETWORK_TRANSMISSION=NO\nHARDWARE_CHANGED=NO\n' "$MAX_AUDIT_RECORDS"
    [ -r "$ACTION_AUDIT_FILE" ] && tail -n "$MAX_AUDIT_RECORDS" "$ACTION_AUDIT_FILE" 2>/dev/null || printf 'NO_AUDIT_RECORDS\n'
}

lock_actions() {
    write_file "$ACTION_LOCK_FILE" ENABLED || { printf 'ACTION_LOCK=ERROR\n'; return 1; }
    load_context; append_audit "$(audit_record emergency_lock LOCK VALID LOCK_ENABLED NOT_APPLICABLE NOT_APPLICABLE 'explicit action lock enabled')" || :
    printf 'ACTION_LOCK=ENABLED\nMODE=DRY_RUN\nDEVICE_APPLY=DENIED\n'
}

unlock_actions() {
    [ "${1:-}" = --explicit-unlock ] || { printf 'ACTION_LOCK=ENABLED\nUNLOCK_DENIED=EXPLICIT_UNLOCK_INTENT_REQUIRED\n'; return 1; }
    load_context
    case "$EVIDENCE_QUALITY" in HEALTHY|VALID) : ;; *) printf 'ACTION_LOCK=ENABLED\nUNLOCK_DENIED=SAFETY_EVIDENCE_NOT_VALIDATED\n'; return 1 ;; esac
    case "$SAFETY_CLASSIFICATION" in READ_ONLY_ADVISORY|READ_ONLY_CONSERVATIVE) : ;; *) printf 'ACTION_LOCK=ENABLED\nUNLOCK_DENIED=SAFETY_CLASSIFICATION_BLOCKED\n'; return 1 ;; esac
    write_file "$ACTION_LOCK_FILE" DISABLED || { printf 'ACTION_LOCK=ERROR\n'; return 1; }
    append_audit "$(audit_record emergency_unlock UNLOCK VALID LOCK_DISABLED NOT_APPLICABLE NOT_APPLICABLE 'explicit unlock affects dry-run planning only; device apply remains unavailable')" || :
    printf 'ACTION_LOCK=DISABLED\nMODE=DRY_RUN\nREAL_DEVICE_APPLY=NOT_AVAILABLE\n'
}

COMMAND="${1:-status}"
case "$COMMAND" in
    status) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; status ;;
    snapshot) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; snapshot ;;
    capabilities) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; capabilities ;;
    history) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; history ;;
    lock) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; lock_actions ;;
    plan|validate|dry-run|verify|rollback) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; case "$COMMAND" in plan) plan_action "$2" ;; validate) validate_action "$2" ;; dry-run) dry_run_action "$2" ;; verify) verify_action "$2" ;; rollback) rollback_action "$2" ;; esac ;;
    apply) [ "$#" -eq 3 ] || { usage >&2; exit 2; }; apply_action "$2" "$3" ;;
    unlock) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; unlock_actions "$2" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
