#!/usr/bin/env sh
# VEGAS-inject Action Safety Gate: fixed simulation-only recommendation validation. No real action execution.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
APP_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
DEFAULT_AXGO_ROOT="$APP_ROOT/AX-T615-GAME-OPTIMIZER"
AXGO_ROOT="$DEFAULT_AXGO_ROOT"
AXGO_DATA_ROOT="$DEFAULT_AXGO_ROOT"
POLICY_ENGINE="$APP_ROOT/bin/policy-engine"
DEFAULT_RUNTIME_DIR="$AXGO_DATA_ROOT/runtime/action-safety-gate"
ACTION_GATE_RUNTIME_DIR="${VEGAS_ACTION_GATE_RUNTIME_DIR:-$DEFAULT_RUNTIME_DIR}"
MAX_AUDIT_RECORDS=16

case "$ACTION_GATE_RUNTIME_DIR" in
    "$APP_ROOT"/*) ;;
    *) ACTION_GATE_RUNTIME_DIR="$DEFAULT_RUNTIME_DIR" ;;
esac
ACTION_GATE_AUDIT_FILE="$ACTION_GATE_RUNTIME_DIR/simulation-audit.log"

usage() {
    cat <<'EOF'
Usage: action-gate {status|evaluate|simulate|capabilities}

Fixed Action Safety Gate. SIMULATION_ONLY is enforced; no real action, command, process,
hardware, network, game, Android-property, /proc, or /sys operation is available.
EOF
}

now() {
    date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || printf '%s' 'unknown-time'
}

escape() {
    printf '%s' "$1" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_value() {
    KEY="$1"
    DATA="$2"
    VALUE=$(printf '%s' "$DATA" | sed -n "s/.*\"$KEY\":\"\([^\"]*\)\".*/\1/p" | head -n 1)
    [ -n "$VALUE" ] && printf '%s' "$VALUE" || printf '%s' 'UNKNOWN'
}

bounded_json() {
    DATA="$1"
    case "$DATA" in \{*\}) ;; *) return 1 ;; esac
    SIZE=$(printf '%s' "$DATA" | wc -c | tr -d '[:space:]')
    case "$SIZE" in ''|*[!0-9]*) return 1 ;; esac
    [ "$SIZE" -le 131072 ] 2>/dev/null
}

has_fragments() {
    DATA="$1"
    shift
    for FRAGMENT do
        case "$DATA" in *"$FRAGMENT"*) ;; *) return 1 ;; esac
    done
}

policy_output_valid() {
    bounded_json "$1" && has_fragments "$1" \
        '"schema":"1"' '"read_only":true' '"policy_state":"' \
        '"recommendation":"' '"confidence":"' '"evidence_quality":"' \
        '"provenance":"' '"safety_classification":"'
}

trusted_evidence_file() {
    CANDIDATE="${ORCH_EVIDENCE_FILE:-}"
    case "$CANDIDATE" in
        '') printf '%s' '' ;;
        "$APP_ROOT"/tests/.tmp/*|"$AXGO_DATA_ROOT"/runtime/*)
            [ -r "$CANDIDATE" ] && printf '%s' "$CANDIDATE" || printf '%s' ''
            ;;
        *) printf '%s' '' ;;
    esac
}

policy_snapshot() {
    OUTPUT=$(AXGO_ROOT="$AXGO_ROOT" AXGO_DATA_ROOT="$AXGO_DATA_ROOT" ORCH_EVIDENCE_FILE="$(trusted_evidence_file)" sh "$POLICY_ENGINE" snapshot 2>/dev/null || :)
    if policy_output_valid "$OUTPUT"; then
        printf '%s' "$OUTPUT"
    else
        printf '%s' '{"schema":"1","source":"unavailable","read_only":true,"policy_state":"INSUFFICIENT_EVIDENCE","recommendation":"remain_conservative","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","bottleneck":"INSUFFICIENT_EVIDENCE","safety_classification":"READ_ONLY_CONSERVATIVE_FALLBACK","provenance":"unavailable"}'
    fi
}

allowed_recommendation() {
    case "$1" in
        remain_conservative|collect_more_evidence|continue_monitoring|retain_current_profile|consider_performance_profile|consider_cool_profile|consider_battery_profile|inspect_frame_pacing|inspect_cpu_pressure|inspect_thermal_conditions|inspect_memory_pressure|inspect_power_conditions) return 0 ;;
        *) return 1 ;;
    esac
}

allowed_policy_state() {
    case "$1" in
        SAFE|BALANCED|CONSERVATIVE|PERFORMANCE_ADVISORY|COOL_ADVISORY|BATTERY_ADVISORY|SAFETY_BLOCKED|INSUFFICIENT_EVIDENCE) return 0 ;;
        *) return 1 ;;
    esac
}

allowed_confidence() {
    case "$1" in HIGH|MEDIUM) return 0 ;; *) return 1 ;; esac
}

acceptable_evidence_quality() {
    case "$1" in VALID|HEALTHY) return 0 ;; *) return 1 ;; esac
}

known_analysis() {
    case "$1" in UNKNOWN|UNAVAILABLE|STALE|INVALID|INSUFFICIENT_EVIDENCE|'') return 1 ;; *) return 0 ;; esac
}

read_only_safety_classification() {
    case "$1" in READ_ONLY_ADVISORY|READ_ONLY_CONSERVATIVE|READ_ONLY_CONSERVATIVE_FALLBACK|READ_ONLY_THERMAL_PROTECTION|READ_ONLY_MEMORY_PROTECTION|READ_ONLY_POWER_PROTECTION) return 0 ;; *) return 1 ;; esac
}

known_provenance() {
    case "$1" in ''|UNKNOWN|UNAVAILABLE|INVALID|NONE|unavailable) return 1 ;; *) return 0 ;; esac
}

derive_request() {
    INTERNAL_ACTION_ID='SIMULATED_RECOMMENDATION_REVIEW'
    INTERNAL_ACTION_TYPE='SIMULATION_ONLY'
    INTERNAL_ACTION_TARGET='VEGAS_INJECT_POLICY_OUTPUT'
    INTERNAL_ACTION_PURPOSE='validate and simulate an internally generated advisory recommendation without execution'
}

load_context() {
    POLICY=$(policy_snapshot)
    POLICY_STATE=$(json_value policy_state "$POLICY")
    RECOMMENDATION=$(json_value recommendation "$POLICY")
    CONFIDENCE=$(json_value confidence "$POLICY")
    EVIDENCE_QUALITY=$(json_value evidence_quality "$POLICY")
    ANALYSIS=$(json_value bottleneck "$POLICY")
    SAFETY_CLASSIFICATION=$(json_value safety_classification "$POLICY")
    PROVENANCE=$(json_value provenance "$POLICY")
    GENERATED_AT=$(json_value generated_at "$POLICY")
    derive_request
}

evaluate_gate() {
    load_context
    GATE_STATE=BLOCKED
    SIMULATION_STATUS=SIMULATION_BLOCKED
    GATE_REASON='global action gate is enabled but simulation requires validated internal policy context'
    SIMULATED_RECOMMENDATION='remain_conservative'

    allowed_policy_state "$POLICY_STATE" || {
        GATE_REASON="policy state $POLICY_STATE is not recognized by the fixed gate"
        return 1
    }
    allowed_recommendation "$RECOMMENDATION" || {
        GATE_REASON="policy recommendation $RECOMMENDATION is not a fixed advisory recommendation"
        return 1
    }
    acceptable_evidence_quality "$EVIDENCE_QUALITY" || {
        GATE_REASON="evidence quality $EVIDENCE_QUALITY is not sufficient for simulation"
        return 1
    }
    allowed_confidence "$CONFIDENCE" || {
        GATE_REASON="policy confidence $CONFIDENCE is insufficient for simulation"
        return 1
    }
    known_provenance "$PROVENANCE" || {
        GATE_REASON='policy provenance is unavailable or invalid'
        return 1
    }
    known_analysis "$ANALYSIS" || {
        GATE_REASON="analysis classification $ANALYSIS is not known"
        return 1
    }
    read_only_safety_classification "$SAFETY_CLASSIFICATION" || {
        GATE_REASON="safety classification $SAFETY_CLASSIFICATION does not authorize a simulation"
        return 1
    }

    GATE_STATE=ALLOWED
    SIMULATION_STATUS=SIMULATION_READY
    SIMULATED_RECOMMENDATION="$RECOMMENDATION"
    GATE_REASON='all fixed safety checks passed; recommendation is simulated only and no real action is available'
    return 0
}

ensure_audit_runtime() {
    umask 077
    [ ! -L "$ACTION_GATE_RUNTIME_DIR" ] || return 1
    mkdir -p "$ACTION_GATE_RUNTIME_DIR" 2>/dev/null && chmod 700 "$ACTION_GATE_RUNTIME_DIR" 2>/dev/null
}

audit_count() {
    [ -r "$ACTION_GATE_AUDIT_FILE" ] || { printf '%s' 0; return; }
    awk 'END { print NR + 0 }' "$ACTION_GATE_AUDIT_FILE" 2>/dev/null
}

append_simulation_audit() {
    ensure_audit_runtime || return 1
    TEMP_AUDIT="$ACTION_GATE_AUDIT_FILE.tmp.$$"
    [ ! -L "$ACTION_GATE_AUDIT_FILE" ] && [ ! -e "$TEMP_AUDIT" ] || return 1
    (umask 077; set -C; : > "$TEMP_AUDIT") 2>/dev/null || return 1
    RECORD="timestamp=$(now);operation=simulate;gate_state=$GATE_STATE;simulation_status=$SIMULATION_STATUS;request_id=$INTERNAL_ACTION_ID;policy_state=$POLICY_STATE;recommendation=$RECOMMENDATION;evidence_quality=$EVIDENCE_QUALITY;confidence=$CONFIDENCE;analysis=$ANALYSIS;safety=$SAFETY_CLASSIFICATION;real_action_execution=NOT_AVAILABLE"
    { [ -r "$ACTION_GATE_AUDIT_FILE" ] && tail -n $((MAX_AUDIT_RECORDS - 1)) "$ACTION_GATE_AUDIT_FILE" 2>/dev/null || :; printf '%s\n' "$RECORD"; } > "$TEMP_AUDIT" 2>/dev/null || return 1
    mv -f "$TEMP_AUDIT" "$ACTION_GATE_AUDIT_FILE" 2>/dev/null || { rm -f "$TEMP_AUDIT" 2>/dev/null || :; return 1; }
}

emit_json() {
    AUDIT_APPENDED="$1"
    printf '{'
    printf '"schema":"1",'
    printf '"source":"vegas-inject-action-safety-gate",'
    printf '"read_only":true,'
    printf '"generated_at":"%s",' "$(escape "$GENERATED_AT")"
    printf '"action_gate":"ENABLED",'
    printf '"execution_mode":"SIMULATION_ONLY",'
    printf '"real_action_execution":"NOT_AVAILABLE",'
    printf '"gate_state":"%s",' "$(escape "$GATE_STATE")"
    printf '"simulation_status":"%s",' "$(escape "$SIMULATION_STATUS")"
    printf '"simulated_recommendation":"%s",' "$(escape "$SIMULATED_RECOMMENDATION")"
    printf '"reason":"%s",' "$(escape "$GATE_REASON")"
    printf '"policy_state":"%s",' "$(escape "$POLICY_STATE")"
    printf '"recommendation":"%s",' "$(escape "$RECOMMENDATION")"
    printf '"evidence_quality":"%s",' "$(escape "$EVIDENCE_QUALITY")"
    printf '"confidence":"%s",' "$(escape "$CONFIDENCE")"
    printf '"analysis":"%s",' "$(escape "$ANALYSIS")"
    printf '"safety_classification":"%s",' "$(escape "$SAFETY_CLASSIFICATION")"
    printf '"provenance":"%s",' "$(escape "$PROVENANCE")"
    printf '"request":{"id":"%s","type":"%s","target":"%s","purpose":"%s","caller_input":"NOT_ACCEPTED"},' "$(escape "$INTERNAL_ACTION_ID")" "$(escape "$INTERNAL_ACTION_TYPE")" "$(escape "$INTERNAL_ACTION_TARGET")" "$(escape "$INTERNAL_ACTION_PURPOSE")"
    printf '"audit":{"count":%s,"maximum":%s,"bounded":true,"immutable":true,"appended_after_simulation":"%s"},' "$(audit_count)" "$MAX_AUDIT_RECORDS" "$AUDIT_APPENDED"
    printf '"safety":{"read_only":"YES","simulation_only":"YES","real_action_execution":"NOT_AVAILABLE","hardware_writes":"NO","proc_writes":"NO","sys_writes":"NO","android_property_writes":"NO","process_control":"NO","network_operations":"NO","arbitrary_execution":"NO","filesystem_control":"NO","forbidden_actions_blocked":"YES"}'
    printf '}\n'
}

status() {
    evaluate_gate || :
    printf 'VEGAS-INJECT ACTION SAFETY GATE\n'
    printf 'Action gate: ENABLED\n'
    printf 'Execution mode: SIMULATION_ONLY\n'
    printf 'Real action execution: NOT_AVAILABLE\n'
    printf 'Gate state: %s\n' "$GATE_STATE"
    printf 'Simulation status: %s\n' "$SIMULATION_STATUS"
    printf 'Simulated recommendation: %s\n' "$SIMULATED_RECOMMENDATION"
    printf 'Evidence quality: %s\n' "$EVIDENCE_QUALITY"
    printf 'Confidence: %s\n' "$CONFIDENCE"
    printf 'Audit records: %s/%s\n' "$(audit_count)" "$MAX_AUDIT_RECORDS"
    printf 'Hardware writes: NO\nProcess control: NO\nNetwork operations: NO\n'
}

capabilities() {
    cat <<'EOF'
ACTION_GATE_CAPABILITIES=status,evaluate,simulate,capabilities
ACTION_GATE=ENABLED
EXECUTION_MODE=SIMULATION_ONLY
REAL_ACTION_EXECUTION=NOT_AVAILABLE
CALLER_SUPPLIED_ACTIONS=REJECTED
INTERNALLY_DERIVED_POLICY_REQUESTS=YES
BOUNDED_IMMUTABLE_AUDIT=YES
HARDWARE_WRITES=NO
PROC_WRITES=NO
SYS_WRITES=NO
ANDROID_PROPERTY_WRITES=NO
PROCESS_CONTROL=NO
NETWORK_OPERATIONS=NO
ARBITRARY_EXECUTION=NO
FILESYSTEM_CONTROL=NO
EOF
}

case "${1:-status}" in
    status) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; status ;;
    evaluate) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; evaluate_gate || :; emit_json NO ;;
    simulate) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; evaluate_gate || :; append_simulation_audit || :; emit_json YES ;;
    capabilities) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; capabilities ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
