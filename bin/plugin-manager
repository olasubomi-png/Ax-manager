#!/usr/bin/env sh
# VEGAS-inject plugin manager: metadata is declarative data and dispatch uses fixed allowlists only.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
APP_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
REGISTRY="$APP_ROOT/plugins/registry.json"
PLUGIN_IDS='ax-t615-game-optimizer system-observer performance-observer'
FORBIDDEN_CAPABILITIES='write_proc write_sys write_power_hal write_governor write_charging_limit modify_battery kill_process force_stop modify_zram modify_swap modify_lmkd disable_thermal_protection disable_battery_protection'
FORBIDDEN_METADATA_KEYS='command script exec shell action path'

usage() {
    cat <<'EOF'
Usage: plugin-manager {list|info <plugin>|inspect <plugin>|status <plugin>|capabilities <plugin>|validate [plugin]|invoke <plugin> <operation>|summary}

Only registered plugins with valid read-only metadata and fixed entrypoints are available.
EOF
}

json_string() {
    KEY="$1"
    FILE="$2"
    sed -n "s/.*\"$KEY\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$FILE" 2>/dev/null | head -n 1
}

json_bool() {
    KEY="$1"
    FILE="$2"
    sed -n "s/.*\"$KEY\"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p" "$FILE" 2>/dev/null | head -n 1
}

valid_id() {
    case "$1" in
        ax-t615-game-optimizer|system-observer|performance-observer) return 0 ;;
        *) return 1 ;;
    esac
}

plugin_dir() {
    printf '%s/plugins/%s' "$APP_ROOT" "$1"
}

registered() {
    ID="$1"
    valid_id "$ID" && grep -Fq "\"id\": \"$ID\"" "$REGISTRY" 2>/dev/null
}

enabled() {
    ID="$1"
    awk -v id="$ID" '
        index($0, "\"id\": \"" id "\"") { found=1; next }
        found && /"enabled"[[:space:]]*:[[:space:]]*true/ { print "true"; exit }
        found && /"enabled"[[:space:]]*:[[:space:]]*false/ { print "false"; exit }
        found && /}/ { exit }
    ' "$REGISTRY" 2>/dev/null | head -n 1
}

set_plugin_paths() {
    ID="$1"
    PLUGIN_DIR=$(plugin_dir "$ID")
    PLUGIN_META="$PLUGIN_DIR/plugin.json"
    PLUGIN_ENTRYPOINT="$PLUGIN_DIR/plugin.sh"
}

plugin_type_valid() {
    case "$1" in
        gaming|system) return 0 ;;
        *) return 1 ;;
    esac
}

validate() {
    ID="${1:-}"
    if ! valid_id "$ID" || ! registered "$ID"; then
        printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=UNREGISTERED\n'
        return 1
    fi
    set_plugin_paths "$ID"
    if [ ! -r "$PLUGIN_META" ] || [ ! -r "$PLUGIN_ENTRYPOINT" ]; then
        printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=REQUIRED_FILE_MISSING\n'
        return 1
    fi
    [ "$(json_string id "$PLUGIN_META")" = "$ID" ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=INVALID_ID\n'; return 1; }
    [ -n "$(json_string name "$PLUGIN_META")" ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=NAME_MISSING\n'; return 1; }
    [ -n "$(json_string version "$PLUGIN_META")" ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=VERSION_MISSING\n'; return 1; }
    [ -n "$(json_string description "$PLUGIN_META")" ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=DESCRIPTION_MISSING\n'; return 1; }
    plugin_type_valid "$(json_string type "$PLUGIN_META")" || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=INVALID_TYPE\n'; return 1; }
    [ "$(json_string entrypoint "$PLUGIN_META")" = 'plugin.sh' ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=ENTRYPOINT_REJECTED\n'; return 1; }
    [ "$(json_bool read_only "$PLUGIN_META")" = 'true' ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=READ_ONLY_REQUIRED\n'; return 1; }
    [ "$(json_bool hardware_writes "$PLUGIN_META")" = 'false' ] || { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=HARDWARE_WRITES_FORBIDDEN\n'; return 1; }
    for CAPABILITY in $FORBIDDEN_CAPABILITIES; do
        grep -Fq "\"$CAPABILITY\"" "$PLUGIN_META" 2>/dev/null && { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=FORBIDDEN_CAPABILITY\n'; return 1; }
    done
    for KEY in $FORBIDDEN_METADATA_KEYS; do
        grep -Eq "\"$KEY\"[[:space:]]*:" "$PLUGIN_META" 2>/dev/null && { printf 'PLUGIN_VALID=NO\nPLUGIN_ERROR=EXECUTABLE_METADATA_REJECTED\n'; return 1; }
    done
    printf 'PLUGIN_VALID=YES\nREAD_ONLY=YES\nHARDWARE_WRITES=NO\nFORBIDDEN_ACTIONS_BLOCKED=YES\n'
}

plugin_info() {
    ID="$1"
    validate "$ID" >/dev/null || { validate "$ID"; return 1; }
    set_plugin_paths "$ID"
    printf 'PLUGIN_ID=%s\n' "$ID"
    printf 'PLUGIN_NAME=%s\n' "$(json_string name "$PLUGIN_META")"
    printf 'PLUGIN_VERSION=%s\n' "$(json_string version "$PLUGIN_META")"
    printf 'PLUGIN_DESCRIPTION=%s\n' "$(json_string description "$PLUGIN_META")"
    printf 'PLUGIN_TYPE=%s\n' "$(json_string type "$PLUGIN_META")"
    printf 'PLUGIN_ENTRYPOINT=plugin.sh (fixed allowlist)\n'
    printf 'READ_ONLY=YES\nHARDWARE_WRITES=NO\n'
}

plugin_capabilities() {
    ID="$1"
    validate "$ID" >/dev/null || { validate "$ID"; return 1; }
    case "$ID" in
        ax-t615-game-optimizer)
            CAPS='status,capabilities,games,game-detection,profiles,fps-analysis,performance-analysis,memory-monitoring,thermal-monitoring,power-telemetry,orchestrator-status,evidence,analysis,policy,action,dashboard,dry-run'
            ;;
        system-observer)
            CAPS='status,capabilities,inspect,snapshot'
            ;;
        performance-observer)
            CAPS='status,capabilities,inspect,snapshot'
            ;;
        *) exit 1 ;;
    esac
    printf 'PLUGIN_ID=%s\nCAPABILITIES=%s\nREAD_ONLY=YES\nHARDWARE_WRITES=NO\nFORBIDDEN_ACTIONS_BLOCKED=YES\n' "$ID" "$CAPS"
}

plugin_status() {
    ID="$1"
    if ! registered "$ID"; then
        printf 'PLUGIN_ID=%s\nLIFECYCLE=ERROR\nPLUGIN_ERROR=UNREGISTERED\n' "$ID"
        return 1
    fi
    if [ "$(enabled "$ID")" != 'true' ]; then
        printf 'PLUGIN_ID=%s\nLIFECYCLE=DISABLED\nAVAILABILITY=DISABLED\nREAD_ONLY=YES\nHARDWARE_WRITES=NO\n' "$ID"
        return 0
    fi
    validate "$ID" >/dev/null || { printf 'PLUGIN_ID=%s\nLIFECYCLE=ERROR\n' "$ID"; validate "$ID"; return 1; }
    printf 'PLUGIN_ID=%s\nLIFECYCLE=ENABLED\nAVAILABILITY=AVAILABLE\nREAD_ONLY=YES\nHARDWARE_WRITES=NO\n' "$ID"
}

list_plugins() {
    DISCOVERED=0
    VALID=0
    printf 'VEGAS-INJECT PLUGINS\n'
    for ID in $PLUGIN_IDS; do
        registered "$ID" || continue
        DISCOVERED=$((DISCOVERED + 1))
        if [ "$(enabled "$ID")" != 'true' ]; then
            printf '%s | DISABLED | VALID | READ_ONLY\n' "$ID"
        elif validate "$ID" >/dev/null 2>&1; then
            VALID=$((VALID + 1))
            printf '%s | ENABLED | VALID | READ_ONLY\n' "$ID"
        else
            printf '%s | ERROR | INVALID | READ_ONLY\n' "$ID"
        fi
    done
    printf 'PLUGINS_DISCOVERED=%s\nPLUGINS_VALID=%s\n' "$DISCOVERED" "$VALID"
}

invoke() {
    ID="$1"
    OPERATION="$2"
    ARGUMENT="${3:-}"
    [ "$#" -le 3 ] || { printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2; }
    plugin_status "$ID" >/dev/null || return 1
    set_plugin_paths "$ID"
    case "$ID:$OPERATION" in
        system-observer:status|system-observer:capabilities|system-observer:inspect|system-observer:snapshot)
            [ -z "$ARGUMENT" ] || { printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2; }
            exec sh "$PLUGIN_ENTRYPOINT" "$OPERATION"
            ;;
        performance-observer:status|performance-observer:capabilities|performance-observer:inspect|performance-observer:snapshot)
            [ -z "$ARGUMENT" ] || { printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2; }
            exec sh "$PLUGIN_ENTRYPOINT" "$OPERATION"
            ;;
        ax-t615-game-optimizer:status|ax-t615-game-optimizer:capabilities|ax-t615-game-optimizer:games|ax-t615-game-optimizer:game-detection|ax-t615-game-optimizer:profiles|ax-t615-game-optimizer:fps-analysis|ax-t615-game-optimizer:performance-analysis|ax-t615-game-optimizer:memory-monitoring|ax-t615-game-optimizer:thermal-monitoring|ax-t615-game-optimizer:power-telemetry|ax-t615-game-optimizer:orchestrator-status|ax-t615-game-optimizer:dry-run)
            [ -z "$ARGUMENT" ] || { printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2; }
            exec sh "$PLUGIN_ENTRYPOINT" "$OPERATION"
            ;;
        ax-t615-game-optimizer:dashboard)
            case "$ARGUMENT" in
                ''|path|snapshot|core-snapshot) exec sh "$PLUGIN_ENTRYPOINT" dashboard "${ARGUMENT:-path}" ;;
                *) printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2 ;;
            esac
            ;;
        ax-t615-game-optimizer:evidence)
            case "$ARGUMENT" in
                ''|status|capabilities|inspect|evaluate|snapshot|history) exec sh "$PLUGIN_ENTRYPOINT" evidence "${ARGUMENT:-status}" ;;
                *) printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2 ;;
            esac
            ;;
        ax-t615-game-optimizer:analysis)
            case "$ARGUMENT" in
                ''|status|analyze|snapshot|capabilities) exec sh "$PLUGIN_ENTRYPOINT" analysis "${ARGUMENT:-status}" ;;
                *) printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2 ;;
            esac
            ;;
        ax-t615-game-optimizer:policy)
            case "$ARGUMENT" in
                ''|status|evaluate|snapshot|capabilities) exec sh "$PLUGIN_ENTRYPOINT" policy "${ARGUMENT:-status}" ;;
                *) printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2 ;;
            esac
            ;;
        ax-t615-game-optimizer:action)
            case "$ARGUMENT" in
                ''|status|capabilities|plan|validate|dry-run|apply|rollback|history|lock|unlock) exec sh "$PLUGIN_ENTRYPOINT" action "${ARGUMENT:-status}" ;;
                *) printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2 ;;
            esac
            ;;
        *) printf 'PLUGIN_ERROR=OPERATION_REJECTED\n' >&2; return 2 ;;
    esac
}

summary() {
    DISCOVERED=0
    VALID=0
    for ID in $PLUGIN_IDS; do
        registered "$ID" || continue
        DISCOVERED=$((DISCOVERED + 1))
        validate "$ID" >/dev/null 2>&1 && VALID=$((VALID + 1))
    done
    printf 'VEGAS_INJECT=READY\nPLUGINS_DISCOVERED=%s\nPLUGINS_VALID=%s\nREAD_ONLY=YES\nHARDWARE_WRITES=NO\n' "$DISCOVERED" "$VALID"
}

case "${1:-summary}" in
    list) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; list_plugins ;;
    info|inspect) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; plugin_info "$2" ;;
    status) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; plugin_status "$2" ;;
    capabilities) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; plugin_capabilities "$2" ;;
    validate) [ "$#" -le 2 ] || { usage >&2; exit 2; }; validate "${2:-ax-t615-game-optimizer}" ;;
    invoke) [ "$#" -ge 3 ] || { usage >&2; exit 2; }; invoke "$2" "$3" "${4:-}" ;;
    summary) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; summary ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
