#!/system/bin/sh

getprop_safe() {
    if command -v getprop >/dev/null 2>&1; then
        getprop "$1" 2>/dev/null
    fi
}

first_nonempty() {
    [ -n "$1" ] && echo "$1" && return 0
    [ -n "$2" ] && echo "$2" && return 0
    echo "unknown"
}

echo "AX-T615 hardware detector (read-only)"
echo "Manufacturer: $(first_nonempty "$(getprop_safe ro.product.manufacturer)" "$(getprop_safe ro.product.brand)")"
echo "Model: $(getprop_safe ro.product.model)"
echo "Android version: $(first_nonempty "$(getprop_safe ro.build.version.release)" "$(getprop_safe ro.build.version.sdk)")"
echo "SoC: $(first_nonempty "$(getprop_safe ro.soc.model)" "$(getprop_safe ro.board.platform)")"

if command -v getconf >/dev/null 2>&1; then
    CPU_CORES="$(getconf _NPROCESSORS_ONLN 2>/dev/null)"
fi
[ -n "$CPU_CORES" ] || CPU_CORES="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
echo "CPU cores: ${CPU_CORES:-unknown}"

echo "CPU frequencies:"
CPU_FOUND="no"
for CPU_DIR in /sys/devices/system/cpu/cpu[0-9]*; do
    [ -d "$CPU_DIR/cpufreq" ] || continue
    CPU_FOUND="yes"
    CPU_NAME="${CPU_DIR##*/}"
    CURRENT=""
    MAXIMUM=""
    if [ -r "$CPU_DIR/cpufreq/cpuinfo_cur_freq" ]; then
        CURRENT="$(cat "$CPU_DIR/cpufreq/cpuinfo_cur_freq" 2>/dev/null)"
    elif [ -r "$CPU_DIR/cpufreq/scaling_cur_freq" ]; then
        CURRENT="$(cat "$CPU_DIR/cpufreq/scaling_cur_freq" 2>/dev/null)"
    fi
    [ -r "$CPU_DIR/cpufreq/cpuinfo_max_freq" ] && MAXIMUM="$(cat "$CPU_DIR/cpufreq/cpuinfo_max_freq" 2>/dev/null)"
    [ -n "$MAXIMUM" ] || [ ! -r "$CPU_DIR/cpufreq/scaling_max_freq" ] || MAXIMUM="$(cat "$CPU_DIR/cpufreq/scaling_max_freq" 2>/dev/null)"
    echo "  $CPU_NAME: current=${CURRENT:-unknown} max=${MAXIMUM:-unknown}"
done
[ "$CPU_FOUND" = "yes" ] || echo "  unavailable"

echo "Available governors:"
GOVERNOR_FOUND="no"
for GOVERNOR_FILE in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_available_governors; do
    [ -r "$GOVERNOR_FILE" ] || continue
    GOVERNOR_FOUND="yes"
    echo "  $(dirname "$GOVERNOR_FILE"): $(cat "$GOVERNOR_FILE" 2>/dev/null)"
done
[ "$GOVERNOR_FOUND" = "yes" ] || echo "  unavailable"

echo "GPU:"
GPU_INFO="$(getprop_safe ro.hardware.egl)"
[ -n "$GPU_INFO" ] || GPU_INFO="$(getprop_safe ro.hardware.vulkan)"
echo "  properties: ${GPU_INFO:-unknown}"
GPU_FOUND="no"
for GPU_PATH in /sys/class/misc/mali0 /sys/devices/platform/*mali* /sys/class/devfreq/*gpu*; do
    if [ -e "$GPU_PATH" ]; then
        GPU_FOUND="yes"
        echo "  path: $GPU_PATH"
    fi
done
[ "$GPU_FOUND" = "yes" ] || echo "  discoverable sysfs path: unavailable"

echo "Thermal zones:"
THERMAL_FOUND="no"
for ZONE in /sys/class/thermal/thermal_zone[0-9]*; do
    [ -d "$ZONE" ] || continue
    THERMAL_FOUND="yes"
    ZONE_TYPE=""
    ZONE_TEMP=""
    [ -r "$ZONE/type" ] && ZONE_TYPE="$(cat "$ZONE/type" 2>/dev/null)"
    [ -r "$ZONE/temp" ] && ZONE_TEMP="$(cat "$ZONE/temp" 2>/dev/null)"
    echo "  ${ZONE##*/}: type=${ZONE_TYPE:-unknown} temp=${ZONE_TEMP:-unknown}"
done
[ "$THERMAL_FOUND" = "yes" ] || echo "  unavailable"

REFRESH_RATE=""
if command -v settings >/dev/null 2>&1; then
    REFRESH_RATE="$(settings get system peak_refresh_rate 2>/dev/null)"
    [ "$REFRESH_RATE" = "null" ] && REFRESH_RATE=""
fi
if [ -z "$REFRESH_RATE" ] && command -v dumpsys >/dev/null 2>&1; then
    REFRESH_RATE="$(dumpsys display 2>/dev/null | grep -m 1 -Eo '[0-9]+(\.[0-9]+)? ?Hz' | head -n 1)"
fi
echo "Refresh rate: ${REFRESH_RATE:-unknown}"
echo "No hardware values were written."

exit 0