#!/usr/bin/env sh
# Step 12 design contract: dashboard exports evidence from existing read-only Axmanager engines; it never contains hardware-control logic.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
AXGO_ROOT="${AXGO_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
DASHBOARD_DIR="$AXGO_ROOT/dashboard"
RUNTIME_DIR="${DASHBOARD_RUNTIME_DIR:-$AXGO_ROOT/runtime/dashboard}"
OUTPUT_FILE="$DASHBOARD_DIR/data/current-snapshot.json"

usage() {
    cat <<'EOF'
Usage: dashboard {path|snapshot|core-snapshot|export|help}

  path       Print the static dashboard entry point.
  snapshot   Print a normalized, read-only JSON dashboard snapshot to stdout.
  core-snapshot  Print the AX-T615 snapshot without nested observer envelopes.
  export     Write a normalized snapshot only to dashboard/data/current-snapshot.json.
  help       Print this message.

The dashboard is an observability and policy interface. It never applies CPU, GPU,
thermal, power, charging, memory, or process-control changes.
EOF
}

json_escape() {
    printf '%s' "$1" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

value() {
    KEY="$1"
    DATA="$2"
    RESULT=$(printf '%s\n' "$DATA" | awk -F= -v key="$KEY" '$1 == key { value=$0; sub(/^[^=]*=/, "", value); print value }' | tail -n 1)
    [ -n "$RESULT" ] && printf '%s' "$RESULT" || printf '%s' "UNKNOWN"
}

line_value() {
    KEY="$1"
    DATA="$2"
    RESULT=$(printf '%s\n' "$DATA" | awk -v key="$KEY" 'index($0, key ":") == 1 { value=$0; sub(/^[^:]*:[[:space:]]*/, "", value); print value }' | tail -n 1)
    [ -n "$RESULT" ] && printf '%s' "$RESULT" || printf '%s' "UNKNOWN"
}

trim() {
    printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

profile_json() {
    DATA="$1"
    FIRST=1
    printf '['
    printf '%s\n' "$DATA" | sed '1,2d' | while IFS='|' read -r ID NAME MODE PACKAGES; do
        ID=$(trim "$ID")
        NAME=$(trim "$NAME")
        MODE=$(trim "$MODE")
        PACKAGES=$(trim "$PACKAGES")
        [ -n "$ID" ] || continue
        [ "$FIRST" -eq 1 ] || printf ','
        FIRST=0
        printf '{"id":"%s","name":"%s","mode":"%s","packages":"%s"}' \
            "$(json_escape "$ID")" \
            "$(json_escape "$NAME")" \
            "$(json_escape "$MODE")" \
            "$(json_escape "$PACKAGES")"
    done
    printf ']'
}

plugin_observability_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    MANAGER="${VEGAS_PLUGIN_MANAGER:-$APP_ROOT/bin/plugin-manager}"
    SYSTEM=''
    PERFORMANCE=''
    if [ -n "$APP_ROOT" ] && [ -r "$MANAGER" ]; then
        SYSTEM=$(ORCH_EVIDENCE_FILE="${TMP_EVIDENCE:-${ORCH_EVIDENCE_FILE:-}}" sh "$MANAGER" invoke system-observer snapshot 2>/dev/null || :)
        PERFORMANCE=$(ORCH_EVIDENCE_FILE="${TMP_EVIDENCE:-${ORCH_EVIDENCE_FILE:-}}" sh "$MANAGER" invoke performance-observer snapshot 2>/dev/null || :)
    fi
    [ -n "$SYSTEM" ] || SYSTEM='{"schema":"1","source":"unavailable","read_only":true,"plugin":{"id":"system-observer","status":"UNAVAILABLE","lifecycle":"UNKNOWN"},"system":{},"safety":{"read_only":"YES","hardware_writes":"NO","forbidden_actions_blocked":"YES","sensitive_information":"NOT_COLLECTED"}}'
    [ -n "$PERFORMANCE" ] || PERFORMANCE='{"schema":"1","source":"unavailable","read_only":true,"plugin":{"id":"performance-observer","name":"Performance Observer","status":"UNAVAILABLE","lifecycle":"UNKNOWN"},"evidence":{"cpu":{"utilization":"UNAVAILABLE","state":"UNAVAILABLE"},"gpu":{"utilization":"UNAVAILABLE","state":"UNAVAILABLE"},"memory":{"usage_percent":"UNAVAILABLE","available_mb":"UNAVAILABLE","state":"UNAVAILABLE"},"thermal":{"temperature_c":"UNAVAILABLE","peak_c":"UNAVAILABLE","state":"UNAVAILABLE","trend":"UNAVAILABLE"},"fps":{"value":"UNAVAILABLE","frame_time_ms":"UNAVAILABLE","frame_pacing":"UNAVAILABLE","trend":"UNAVAILABLE"},"battery":{"percent":"UNAVAILABLE","charging":"UNAVAILABLE","temperature_c":"UNAVAILABLE","health":"UNAVAILABLE"},"power":{"voltage_mv":"UNAVAILABLE","current_ma":"UNAVAILABLE","estimated_watts":"UNAVAILABLE","drain_rate":"UNAVAILABLE","state":"UNAVAILABLE"}},"provenance":{"observed_telemetry":"UNAVAILABLE","unavailable_telemetry":"UNAVAILABLE","derived_values":"NONE"},"safety":{"read_only":"YES","hardware_writes":"NO","forbidden_actions_blocked":"YES","network_access":"NOT_AVAILABLE","process_control":"NOT_AVAILABLE"}}'
    printf '{"system_observer":%s,"performance_observer":%s}' "$SYSTEM" "$PERFORMANCE"
}

evidence_engine_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    ENGINE="${VEGAS_EVIDENCE_ENGINE:-$APP_ROOT/bin/evidence-engine}"
    ENGINE_JSON=''
    if [ -n "$APP_ROOT" ] && [ -r "$ENGINE" ]; then
        ENGINE_JSON=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" sh "$ENGINE" snapshot 2>/dev/null || :)
    fi
    [ -n "$ENGINE_JSON" ] || ENGINE_JSON='{"schema":"1","source":"unavailable","read_only":true,"quality":{"classification":"UNSAFE_UNKNOWN","conditions":"NONE","fallback_required":"YES","fallback_reason":"evidence engine unavailable"},"metrics":{},"history":{"maximum_samples":8,"retained_samples":0,"contains_personal_data":false,"trends":{}},"safety":{"read_only":"YES","hardware_writes":"NO","forbidden_actions_blocked":"YES"}}'
    printf '%s' "$ENGINE_JSON"
}

analysis_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    ENGINE="${VEGAS_BOTTLENECK_ENGINE:-$APP_ROOT/bin/bottleneck-engine}"
    ENGINE_JSON=''
    if [ -n "$APP_ROOT" ] && [ -r "$ENGINE" ]; then
        ENGINE_JSON=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" sh "$ENGINE" snapshot 2>/dev/null || :)
    fi
    [ -n "$ENGINE_JSON" ] || ENGINE_JSON='{"schema":"1","source":"unavailable","read_only":true,"classification":"INSUFFICIENT_EVIDENCE","confidence":"LOW","reason":"bottleneck engine unavailable","supporting_evidence":"NONE","conflicting_evidence":"NONE","evidence_quality":"UNSAFE_UNKNOWN","provenance":"unavailable","recommended_observation":"remain_conservative","safety_classification":"READ_ONLY_CONSERVATIVE_FALLBACK","history":{"retained_samples":0,"bounded":true},"safety":{"read_only":"YES","hardware_writes":"NO","forbidden_actions_blocked":"YES","advisory_only":"YES"}}'
    printf '%s' "$ENGINE_JSON"
}

policy_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    ENGINE="${VEGAS_POLICY_ENGINE:-$APP_ROOT/bin/policy-engine}"
    ENGINE_JSON=''
    if [ -n "$APP_ROOT" ] && [ -r "$ENGINE" ]; then
        ENGINE_JSON=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" sh "$ENGINE" snapshot 2>/dev/null || :)
    fi
    [ -n "$ENGINE_JSON" ] || ENGINE_JSON='{"schema":"1","source":"unavailable","read_only":true,"policy_state":"INSUFFICIENT_EVIDENCE","recommendation":"remain_conservative","confidence":"LOW","priority":"SAFETY","reason":"policy engine unavailable","evidence_quality":"UNSAFE_UNKNOWN","bottleneck":"INSUFFICIENT_EVIDENCE","bottleneck_confidence":"LOW","supporting_evidence":"NONE","rejected_options":"performance_advisory,automatic_action","safety_classification":"READ_ONLY_CONSERVATIVE_FALLBACK","provenance":"unavailable","history":{"retained_samples":0,"bounded":true},"safety":{"read_only":"YES","hardware_writes":"NO","forbidden_actions_blocked":"YES","advisory_only":"YES","action_layer":"NOT_IMPLEMENTED"}}'
    printf '%s' "$ENGINE_JSON"
}

action_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    ENGINE="${VEGAS_ACTION_ENGINE:-$APP_ROOT/bin/action-engine}"
    ACTION_JSON=''
    if [ -n "$APP_ROOT" ] && [ -r "$ENGINE" ]; then
        ACTION_JSON=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" AXGO_DATA_ROOT="${AXGO_DATA_ROOT:-$AXGO_ROOT}" sh "$ENGINE" snapshot 2>/dev/null || :)
    fi
    [ -n "$ACTION_JSON" ] || ACTION_JSON='{"schema":"1","component":"vegas-capability-gated-action-engine","source":"unavailable","read_only":true,"mode":"DRY_RUN","action_lock":"ENABLED","real_device_apply":"NOT_AVAILABLE","device_capabilities":"UNVERIFIED","safety_gate":"ENFORCED","current_recommendation":"remain_conservative","policy_state":"INSUFFICIENT_EVIDENCE","evidence_quality":"UNSAFE_UNKNOWN","confidence":"LOW","planned_action":"refresh_telemetry","validation_status":"REQUIRED","available_actions":"NONE","unsupported_actions":"ALL_DEVICE_ACTIONS_UNSUPPORTED","blocked_actions":"hardware,process,network,arbitrary_execution","rollback_available":"NO_APPLIED_DEVICE_ACTIONS","audit_history":{"count":0,"maximum":16,"bounded":true,"repository_local":true},"safety":{"hardware_writes":false,"process_control":false,"network_execution":false,"arbitrary_execution":false,"device_action_execution":"NOT_AVAILABLE","browser_execution":false}}'
    printf '%s' "$ACTION_JSON"
}

legacy_action_json() {
    cat <<'EOF'
{"schema":"1","source":"vegas-inject-controlled-action-engine","read_only":true,"mode":"DRY_RUN","dry_run_default":"YES","action_lock_default":"ENABLED","action_layer":"CAPABILITY_GATED_DRY_RUN_ONLY","real_device_apply":"NOT_AVAILABLE","rollback_available":"NO_APPLIED_DEVICE_ACTIONS","safety":{"hardware_writes":"NO","process_control":"NO","network_execution":"NO","arbitrary_execution":"NO"}}
EOF
}

action_gate_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    ENGINE="${VEGAS_ACTION_GATE:-$APP_ROOT/bin/action-gate}"
    GATE_JSON=''
    if [ -n "$APP_ROOT" ] && [ -r "$ENGINE" ]; then
        GATE_JSON=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" AXGO_DATA_ROOT="${AXGO_DATA_ROOT:-$AXGO_ROOT}" sh "$ENGINE" evaluate 2>/dev/null || :)
    fi
    [ -n "$GATE_JSON" ] || GATE_JSON='{"schema":"1","source":"unavailable","read_only":true,"action_gate":"ENABLED","execution_mode":"SIMULATION_ONLY","real_action_execution":"NOT_AVAILABLE","gate_state":"BLOCKED","simulation_status":"SIMULATION_BLOCKED","simulated_recommendation":"remain_conservative","reason":"action gate unavailable","evidence_quality":"UNSAFE_UNKNOWN","confidence":"LOW","audit":{"count":0,"maximum":16,"bounded":true,"immutable":true},"safety":{"read_only":"YES","simulation_only":"YES","hardware_writes":"NO","process_control":"NO","network_operations":"NO","arbitrary_execution":"NO","filesystem_control":"NO"}}'
    printf '%s' "$GATE_JSON"
}

control_plane_json() {
    APP_ROOT=$(CDPATH= cd -- "$AXGO_ROOT/.." 2>/dev/null && pwd || :)
    ENGINE="${VEGAS_CONTROL_PLANE:-$APP_ROOT/bin/control-plane}"
    CONTROL_JSON=''
    if [ -n "$APP_ROOT" ] && [ -r "$ENGINE" ]; then
        CONTROL_JSON=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" AXGO_DATA_ROOT="${AXGO_DATA_ROOT:-$AXGO_ROOT}" sh "$ENGINE" snapshot 2>/dev/null || :)
    fi
    [ -n "$CONTROL_JSON" ] || CONTROL_JSON='{"schema":"1","component":"vegas-control-plane","source":"unavailable","read_only":true,"simulation_only":true,"lifecycle":"BLOCKED","state":"BLOCKED","evidence":{"state":"UNSAFE_UNKNOWN","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","provenance":"unavailable","availability":"UNAVAILABLE"},"analysis":{"state":"INSUFFICIENT_EVIDENCE","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","provenance":"unavailable","availability":"UNAVAILABLE"},"policy":{"state":"INSUFFICIENT_EVIDENCE","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","provenance":"unavailable","availability":"UNAVAILABLE"},"recommendation":{"state":"INSUFFICIENT_EVIDENCE","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","provenance":"unavailable","availability":"UNAVAILABLE","value":"remain_conservative","executable":false},"action_gate":{"state":"BLOCKED","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","provenance":"unavailable","availability":"UNAVAILABLE","simulation_status":"SIMULATION_BLOCKED","executed":false,"hardware_changed":false},"plugins":{"state":"DEGRADED","confidence":"LOW","evidence_quality":"UNSAFE_UNKNOWN","provenance":"plugin-manager-fixed-registry","availability":"UNAVAILABLE"},"safety":{"state":"BLOCKED","read_only":true,"simulation_only":true,"hardware_writes":false,"process_control":false,"network":false,"arbitrary_execution":false,"dynamic_dispatch":false,"real_action_layer":"NOT_IMPLEMENTED"},"provenance":{"state":"DERIVED","availability":"UNAVAILABLE"},"simulation":{"simulation":true,"executed":false,"hardware_changed":false},"audit":{"count":0,"maximum":16,"bounded":true}}'
    printf '%s' "$CONTROL_JSON"
}

json_pair() {
    KEY="$1"
    RAW="$2"
    printf '"%s":"%s"' "$KEY" "$(json_escape "$RAW")"
}

snapshot() {
    INCLUDE_PLUGIN_ENVELOPES="${1:-yes}"
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || :
    TMP_EVIDENCE="$RUNTIME_DIR/dashboard-evidence.$$.env"
    trap 'rm -f "$TMP_EVIDENCE" 2>/dev/null || :' EXIT HUP INT TERM

    if [ -n "${ORCH_EVIDENCE_FILE:-}" ] && [ -r "$ORCH_EVIDENCE_FILE" ]; then
        ORCH_EVIDENCE_FILE="$ORCH_EVIDENCE_FILE" AXGO_ROOT="$AXGO_ROOT" sh "$AXGO_ROOT/bin/orchestrator-evidence" > "$TMP_EVIDENCE"
    else
        AXGO_ROOT="$AXGO_ROOT" AXGO_DATA_ROOT="${AXGO_DATA_ROOT:-$AXGO_ROOT}" sh "$AXGO_ROOT/bin/orchestrator-evidence" > "$TMP_EVIDENCE"
    fi

    EVIDENCE=$(cat "$TMP_EVIDENCE")
    DECISION=$(ORCH_EVIDENCE_FILE="$TMP_EVIDENCE" AXGO_ROOT="$AXGO_ROOT" sh "$AXGO_ROOT/bin/orchestrator-decision")
    ORCHESTRATOR=$(AXGO_ROOT="$AXGO_ROOT" ORCH_RUNTIME_DIR="${ORCH_RUNTIME_DIR:-$AXGO_ROOT/runtime/orchestrator}" sh "$AXGO_ROOT/bin/orchestrator" status 2>/dev/null || :)
    SESSION=$(AXGO_ROOT="$AXGO_ROOT" sh "$AXGO_ROOT/bin/session" status 2>/dev/null || :)
    PROFILE=$(AXGO_ROOT="$AXGO_ROOT" sh "$AXGO_ROOT/bin/profile" get 2>/dev/null || :)
    PROFILE_LIST=$(AXGO_ROOT="$AXGO_ROOT" sh "$AXGO_ROOT/bin/game-profile" list 2>/dev/null || :)
    CAPABILITY_ACTION=$(action_json)

    printf '{'
    json_pair schema "1"; printf ','
    json_pair generated_at "$(value TIMESTAMP "$EVIDENCE")"; printf ','
    json_pair source "axmanager-read-only-cli"; printf ','
    printf '"read_only":true,'
    printf '"evidence":{'
    json_pair game "$(value GAME "$EVIDENCE")"; printf ','
    json_pair package "$(value PACKAGE "$EVIDENCE")"; printf ','
    json_pair profile "$(value PROFILE "$EVIDENCE")"; printf ','
    json_pair cpu_utilization "$(value CPU_UTILIZATION "$EVIDENCE")"; printf ','
    json_pair cpu_state "$(value CPU_STATE "$EVIDENCE")"; printf ','
    json_pair gpu_utilization "$(value GPU_UTILIZATION "$EVIDENCE")"; printf ','
    json_pair gpu_state "$(value GPU_STATE "$EVIDENCE")"; printf ','
    json_pair memory_usage_percent "$(value MEMORY_USAGE_PERCENT "$EVIDENCE")"; printf ','
    json_pair memory_available_mb "$(value MEMORY_AVAILABLE_MB "$EVIDENCE")"; printf ','
    json_pair memory_state "$(value MEMORY_STATE "$EVIDENCE")"; printf ','
    json_pair thermal_temp_c "$(value THERMAL_TEMP_C "$EVIDENCE")"; printf ','
    json_pair thermal_peak_c "$(value THERMAL_PEAK_C "$EVIDENCE")"; printf ','
    json_pair thermal_state "$(value THERMAL_STATE "$EVIDENCE")"; printf ','
    json_pair thermal_trend "$(value THERMAL_TREND "$EVIDENCE")"; printf ','
    json_pair fps "$(value FPS "$EVIDENCE")"; printf ','
    json_pair frame_time_ms "$(value FRAME_TIME_MS "$EVIDENCE")"; printf ','
    json_pair frame_pacing "$(value FRAME_PACING "$EVIDENCE")"; printf ','
    json_pair fps_trend "$(value FPS_TREND "$EVIDENCE")"; printf ','
    json_pair battery_percent "$(value BATTERY_PERCENT "$EVIDENCE")"; printf ','
    json_pair charging_state "$(value CHARGING_STATE "$EVIDENCE")"; printf ','
    json_pair battery_health "$(value BATTERY_HEALTH "$EVIDENCE")"; printf ','
    json_pair battery_temp_c "$(value BATTERY_TEMP_C "$EVIDENCE")"; printf ','
    json_pair voltage_mv "$(value VOLTAGE_MV "$EVIDENCE")"; printf ','
    json_pair current_ma "$(value CURRENT_MA "$EVIDENCE")"; printf ','
    json_pair estimated_watts "$(value ESTIMATED_WATTS "$EVIDENCE")"; printf ','
    json_pair drain_rate "$(value DRAIN_RATE "$EVIDENCE")"; printf ','
    json_pair power_state "$(value POWER_STATE "$EVIDENCE")"
    printf '},'
    printf '"decision":{'
    json_pair state "$(value SELECTED_STATE "$DECISION")"; printf ','
    json_pair confidence "$(value CONFIDENCE "$DECISION")"; printf ','
    json_pair priority "$(value PRIORITY "$DECISION")"; printf ','
    json_pair reason "$(value REASON "$DECISION")"; printf ','
    json_pair evidence_quality "$(value EVIDENCE_QUALITY "$DECISION")"; printf ','
    json_pair evidence_conditions "$(value EVIDENCE_CONDITIONS "$DECISION")"; printf ','
    json_pair evidence_freshness "$(value EVIDENCE_FRESHNESS "$DECISION")"; printf ','
    json_pair conservative_fallback_required "$(value CONSERVATIVE_FALLBACK_REQUIRED "$DECISION")"; printf ','
    json_pair conservative_fallback_reason "$(value CONSERVATIVE_FALLBACK_REASON "$DECISION")"; printf ','
    json_pair evidence_summary "$(value EVIDENCE_SUMMARY "$DECISION")"; printf ','
    json_pair recommended_actions "$(value RECOMMENDED_ACTIONS "$DECISION")"; printf ','
    json_pair recovery_conditions "$(value RECOVERY_CONDITIONS "$DECISION")"; printf ','
    json_pair safety_classification "$(value SAFETY_CLASSIFICATION "$DECISION")"; printf ','
    json_pair evidence_status "$(value EVIDENCE_STATUS "$DECISION")"
    printf '},'
    printf '"analysis":'
    analysis_json
    printf ','
    printf '"policy":'
    policy_json
    printf ','
    printf '"action":'
    legacy_action_json
    printf ','
    printf '"capability_action":%s' "$CAPABILITY_ACTION"
    printf ','
    printf '"action_gate":'
    action_gate_json
    printf ','
    printf '"control_plane":'
    control_plane_json
    printf ','
    printf '"orchestrator":{'
    json_pair lifecycle "$(value ORCHESTRATOR_LIFECYCLE "$ORCHESTRATOR")"; printf ','
    json_pair state "$(value ORCHESTRATOR_STATE "$ORCHESTRATOR")"; printf ','
    json_pair stable_samples "$(value STABLE_SAMPLES "$ORCHESTRATOR")"
    printf '},'
    printf '"session":{'
    json_pair status "$(line_value "Gaming session" "$SESSION")"; printf ','
    json_pair game "$(line_value "Current game" "$SESSION")"; printf ','
    json_pair profile "$(line_value "Profile" "$SESSION")"; printf ','
    json_pair selected_profile "$(line_value "Current profile" "$PROFILE")"
    printf '},'
    printf '"profiles":'
    profile_json "$PROFILE_LIST"
    printf ','
    printf '"plugins":'
    if [ "$INCLUDE_PLUGIN_ENVELOPES" = 'yes' ]; then
        plugin_observability_json
    else
        printf '{}'
    fi
    printf ','
    printf '"evidence_engine":'
    evidence_engine_json
    printf ','
    printf '"safety":{'
    json_pair blocked_actions "$(value BLOCKED_ACTIONS "$DECISION")"; printf ','
    json_pair forbidden_actions_blocked "$(value FORBIDDEN_ACTIONS_BLOCKED "$DECISION")"; printf ','
    json_pair read_only "$(value READ_ONLY "$DECISION")"
    printf '}'
    printf '}\n'
}

case "${1:-help}" in
    path) printf '%s\n' "$DASHBOARD_DIR/index.html" ;;
    snapshot) snapshot yes ;;
    core-snapshot) snapshot no ;;
    export)
        mkdir -p "$DASHBOARD_DIR/data" 2>/dev/null || exit 1
        snapshot > "$OUTPUT_FILE" || exit 1
        printf 'DASHBOARD_SNAPSHOT=%s\n' "$OUTPUT_FILE"
        printf 'READ_ONLY=YES\n'
        ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
