#!/system/bin/sh
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" 2>/dev/null && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)"
COMMAND="${1:-status}"

case "$COMMAND" in
    status)
        exec sh "$ROOT_DIR/status.sh"
        ;;
    detect)
        exec sh "$SCRIPT_DIR/detector"
        ;;
    capabilities)
        shift
        exec sh "$SCRIPT_DIR/capabilities" "$@"
        ;;
    cpu)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/cpu-controller" status
        fi
        exec sh "$SCRIPT_DIR/cpu-controller" "$@"
        ;;
    games)
        exec sh "$SCRIPT_DIR/game-db" list
        ;;
    game)
        shift
        exec sh "$SCRIPT_DIR/game-manager" "${1:-status}"
        ;;
    profile)
        shift
        exec sh "$SCRIPT_DIR/profile" "$@"
        ;;
    session)
        shift
        exec sh "$SCRIPT_DIR/session" "${1:-status}"
        ;;
    recovery)
        shift
        exec sh "$SCRIPT_DIR/recovery" "${1:-status}"
        ;;
    thermal)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/thermal-controller" status
        fi
        case "${1:-}" in
            guard)
                shift
                if [ "$#" -eq 0 ]; then
                    exec sh "$SCRIPT_DIR/thermal-guard" status
                fi
                exec sh "$SCRIPT_DIR/thermal-guard" "$@"
                ;;
            *)
                exec sh "$SCRIPT_DIR/thermal-controller" "$@"
                ;;
        esac
        ;;
    gaming)
        echo "Gaming optimization is not implemented yet."
        echo "No hardware settings were changed."
        ;;
    reset)
        exec sh "$SCRIPT_DIR/cpu-reset"
        ;;
    *)
        echo "Usage: axgo {status|detect|capabilities [--save]|cpu [status|inspect|dry-run|apply <profile>|restore|reset]|games|game {status|detect|start|stop|current}|profile [get|set <profile>]|session [start|stop|status|current]|recovery [status|reset]|thermal [status|inspect|monitor|dry-run|guard [status|check|recommend|game-start|game-stop]]|gaming|reset}"
        exit 2
        ;;
esac

exit 0