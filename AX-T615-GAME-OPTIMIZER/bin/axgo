#!/system/bin/sh
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" 2>/dev/null && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)"
COMMAND="${1:-status}"

usage_rejected() {
    echo "AXGO_ERROR=OPERATION_REJECTED" >&2
    exit 2
}

safe_name() {
    case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac
}

validate_fixed_route() {
    ROUTE="$1"
    shift
    case "$ROUTE" in
        status|detect|games|gaming) [ "$#" -eq 0 ] || usage_rejected ;;
        capabilities) [ "$#" -eq 0 ] || usage_rejected ;;
        cpu|gpu)
            case "${1:-status}:$#" in status:0|status:1|inspect:1|capabilities:1|info:1) ;; dry-run:2) case "$2" in cool|balanced|performance) ;; *) usage_rejected ;; esac ;; *) usage_rejected ;; esac
            ;;
        display) case "${1:-status}:$#" in status:0|status:1|inspect:1|refresh:1|modes:1) ;; *) usage_rejected ;; esac ;;
        fps) case "${1:-status}:$#" in status:0|status:1|inspect:1|monitor:1|analyze:1|report:1|recommend:1) ;; *) usage_rejected ;; esac ;;
        performance) case "${1:-analyze}:$#" in analyze:0|analyze:1) ;; *) usage_rejected ;; esac ;;
        power)
            case "${1:-status}:$#" in status:0|status:1|inspect:1|battery:1|charging:1|health:1|temperature:1|estimate:1|dry-run:1|monitor:1|guard:2) ;; *) usage_rejected ;; esac
            case "${1:-}" in guard) case "${2:-status}" in status|check|recommend) ;; *) usage_rejected ;; esac ;; esac
            ;;
        orchestrator)
            case "${1:-status}:$#" in status:0|status:1|decision:1|inspect:1|dry-run:1) ;; dry-run:3) [ "$2" = start ] && safe_name "$3" || usage_rejected ;; *) usage_rejected ;; esac
            ;;
        memory)
            case "${1:-status}:$#" in status:0|status:1|inspect:1|pressure:1|zram:1|swap:1|monitor:1|dry-run:1|guard:2|performance:2) ;; *) usage_rejected ;; esac
            case "${1:-}" in guard|performance) case "${2:-status}" in status|check|recommend) ;; *) usage_rejected ;; esac ;; esac
            ;;
        thermal)
            case "${1:-status}:$#" in status:0|status:1|inspect:1|monitor:1|dry-run:1|guard:2) ;; *) usage_rejected ;; esac
            case "${1:-}" in guard) case "${2:-status}" in status|check|recommend) ;; *) usage_rejected ;; esac ;; esac
            ;;
        game)
            case "${1:-status}:$#" in status:0|active:1|detect:1|profile:2) ;; detect:2) safe_name "$2" || usage_rejected ;; *) usage_rejected ;; esac
            case "${1:-}" in profile) [ "${2:-}" = list ] || usage_rejected ;; esac
            ;;
        profile) case "${1:-get}:$#" in get:0|get:1) ;; *) usage_rejected ;; esac ;;
        session) case "${1:-status}:$#" in status:0|status:1|current:1) ;; *) usage_rejected ;; esac ;;
        recovery) case "${1:-status}:$#" in status:0|status:1) ;; *) usage_rejected ;; esac ;;
        reset|*) usage_rejected ;;
    esac
}

validate_fixed_route "$@"

case "$COMMAND" in
    status)
        exec sh "$ROOT_DIR/status.sh"
        ;;
    detect)
        exec sh "$SCRIPT_DIR/detector"
        ;;
    capabilities)
        shift
        exec sh "$SCRIPT_DIR/capabilities" "$@"
        ;;
    cpu)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/cpu-controller" status
        fi
        exec sh "$SCRIPT_DIR/cpu-controller" "$@"
        ;;
    games)
        exec sh "$SCRIPT_DIR/game-db" list
        ;;
    game)
        shift
        case "${1:-status}" in
            detect)
                shift
                if [ "$#" -eq 1 ]; then
                    exec sh "$SCRIPT_DIR/game-detector" package "$1"
                fi
                exec sh "$SCRIPT_DIR/game-detector" identify
                ;;
            active)
                [ "$#" -eq 1 ] || { echo "Usage: axgo game active" >&2; exit 2; }
                exec sh "$SCRIPT_DIR/game-detector" active
                ;;
            profile)
                shift
                if [ "$#" -eq 0 ]; then
                    exec sh "$SCRIPT_DIR/game-profile" list
                fi
                exec sh "$SCRIPT_DIR/game-profile" "$@"
                ;;
            *)
                exec sh "$SCRIPT_DIR/game-manager" "${1:-status}"
                ;;
        esac
        ;;
    profile)
        shift
        exec sh "$SCRIPT_DIR/profile" "$@"
        ;;
    session)
        shift
        exec sh "$SCRIPT_DIR/session" "${1:-status}"
        ;;
    recovery)
        shift
        exec sh "$SCRIPT_DIR/recovery" "${1:-status}"
        ;;
    thermal)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/thermal-controller" status
        fi
        case "${1:-}" in
            guard)
                shift
                if [ "$#" -eq 0 ]; then
                    exec sh "$SCRIPT_DIR/thermal-guard" status
                fi
                exec sh "$SCRIPT_DIR/thermal-guard" "$@"
                ;;
            *)
                exec sh "$SCRIPT_DIR/thermal-controller" "$@"
                ;;
        esac
        ;;
    gpu)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/gpu-controller" status
        fi
        case "${1:-}" in
            info)
                shift
                exec sh "$SCRIPT_DIR/gpu-info" "$@"
                ;;
            reset)
                shift
                exec sh "$SCRIPT_DIR/gpu-reset" "$@"
                ;;
            *)
                exec sh "$SCRIPT_DIR/gpu-controller" "$@"
                ;;
        esac
        ;;
    display)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/display-controller" status
        fi
        exec sh "$SCRIPT_DIR/display-controller" "$@"
        ;;
    fps)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/fps-controller" status
        fi
        exec sh "$SCRIPT_DIR/fps-controller" "$@"
        ;;
    performance)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/performance-analyzer"
        fi
        exec sh "$SCRIPT_DIR/performance-analyzer" "$@"
        ;;
    power)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/power-controller" status
        fi
        case "${1:-}" in
            guard)
                shift
                if [ "$#" -eq 0 ]; then
                    exec sh "$SCRIPT_DIR/power-guard" status
                fi
                exec sh "$SCRIPT_DIR/power-guard" "$@"
                ;;
            monitor)
                shift
                exec sh "$SCRIPT_DIR/power-monitor" "$@"
                ;;
            dry-run)
                exec sh "$SCRIPT_DIR/power-controller" dry-run
                ;;
            *)
                exec sh "$SCRIPT_DIR/power-controller" "$@"
                ;;
        esac
        ;;
    orchestrator)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/orchestrator" status
        fi
        exec sh "$SCRIPT_DIR/orchestrator" "$@"
        ;;
    memory)
        shift
        if [ "$#" -eq 0 ]; then
            exec sh "$SCRIPT_DIR/memory-controller" status
        fi
        case "${1:-}" in
            monitor)
                shift
                exec sh "$SCRIPT_DIR/memory-monitor" "$@"
                ;;
            guard)
                shift
                exec sh "$SCRIPT_DIR/memory-guard" "${1:-status}"
                ;;
            performance)
                shift
                if [ "$#" -eq 0 ]; then
                    exec sh "$SCRIPT_DIR/memory-performance" status
                fi
                exec sh "$SCRIPT_DIR/memory-performance" "$@"
                ;;
            *)
                exec sh "$SCRIPT_DIR/memory-controller" "$@"
                ;;
        esac
        ;;
    gaming)
        echo "Gaming optimization is not implemented yet."
        echo "No hardware settings were changed."
        ;;
    reset)
        exec sh "$SCRIPT_DIR/cpu-reset"
        ;;
    *)
        echo "Usage: axgo {status|detect|capabilities [--save]|cpu [status|inspect|dry-run|apply <profile>|restore|reset]|gpu [status|inspect|capabilities|dry-run [cool|balanced|performance]|apply <profile>|restore|reset|info]|display [status|inspect|refresh|modes]|fps [status|inspect|monitor|analyze|session-start|session-stop|report|recommend]|performance [analyze]|power [status|inspect|battery|charging|health|temperature|estimate|monitor [--interval seconds]|dry-run|guard [status|check|recommend]]|orchestrator [status|start [game]|sample|decision|inspect|stop|monitor|dry-run]|memory [status|inspect|pressure|zram|swap|monitor [--interval seconds]|dry-run|guard [status|check|recommend]|performance [status|check|recommend|game-start [game]|game-stop]]|games|game {status|detect|active|start|stop|current|profile [list|show <game>|recommend <game>|validate|auto|use <profile>|clear]}|profile [get|set <profile>]|session [start|stop|status|current]|recovery [status|reset]|thermal [status|inspect|monitor|dry-run|guard [status|check|recommend|game-start|game-stop]]|gaming|reset}"
        exit 2
        ;;
esac

exit 0
