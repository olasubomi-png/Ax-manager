#!/usr/bin/env sh
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" 2>/dev/null && pwd)"
AXGO_ROOT="${AXGO_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)}"
DATA_ROOT="${DISPLAY_DATA_ROOT:-${AXGO_DATA_ROOT:-$AXGO_ROOT}}"
CONFIG_FILE="${DISPLAY_POLICY_FILE:-$AXGO_ROOT/config/display-policy.json}"
LOG_FILE="${DISPLAY_LOG_FILE:-$DATA_ROOT/logs/display.log}"

mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || :

display_log() {
    printf '%s [%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || printf '%s' UNKNOWN)" "${1:-INFO}" "${2:-}" >> "$LOG_FILE" 2>/dev/null || :
}

first_readable() {
    for FILE in "$@"; do
        if [ -r "$FILE" ]; then
            cat "$FILE" 2>/dev/null
            return 0
        fi
    done
    return 1
}

source_output() {
    case "$1" in
        display) first_readable "$DATA_ROOT/dumpsys_display" "$DATA_ROOT/display" "$DATA_ROOT/display.txt" "$DATA_ROOT/display.conf" "$DATA_ROOT/dumpsys.display" || { command -v dumpsys >/dev/null 2>&1 && dumpsys display 2>/dev/null; } ;;
        surfaceflinger) first_readable "$DATA_ROOT/dumpsys_surfaceflinger" "$DATA_ROOT/surfaceflinger" "$DATA_ROOT/surfaceflinger.txt" "$DATA_ROOT/dumpsys.surfaceflinger" || { command -v dumpsys >/dev/null 2>&1 && dumpsys SurfaceFlinger 2>/dev/null; } ;;
        size) first_readable "$DATA_ROOT/wm_size" "$DATA_ROOT/size" "$DATA_ROOT/display_size" || { command -v wm >/dev/null 2>&1 && wm size 2>/dev/null; } ;;
        density) first_readable "$DATA_ROOT/wm_density" "$DATA_ROOT/density" "$DATA_ROOT/display_density" || { command -v wm >/dev/null 2>&1 && wm density 2>/dev/null; } ;;
        refresh) first_readable "$DATA_ROOT/refresh" "$DATA_ROOT/refresh_rate" "$DATA_ROOT/settings_refresh" "$DATA_ROOT/refresh_rate.txt" || { command -v settings >/dev/null 2>&1 && { settings get system peak_refresh_rate 2>/dev/null; settings get system min_refresh_rate 2>/dev/null; }; } ;;
esac
}

number() { case "$1" in ''|*[!0-9.]*|.*|*.*.*) return 1 ;; *) return 0 ;; esac; }

parse_resolution() {
    printf '%s\n' "$DISPLAY_ALL" | grep -oE '[0-9]{3,5}[[:space:]]x[[:space:]][0-9]{3,5}|[0-9]{3,5}x[0-9]{3,5}' 2>/dev/null | head -n 1 | tr -d ' '
}

parse_density() {
    printf '%s\n' "$DISPLAY_ALL" | sed -n -E 's/.*([Dd]ensity|density)[^0-9]*([0-9]{2,4}).*/\2/p' | head -n 1
}

parse_id() {
    ID="$(printf '%s\n' "$DISPLAY_ALL" | sed -n -E 's/.*(mDisplayId|displayId|uniqueId)[^0-9]*([0-9]+).*/\2/p' | head -n 1)"
    [ -n "$ID" ] && printf '%s' "$ID" || printf '%s' UNKNOWN
}

parse_refresh_current() {
    CURRENT="$(printf '%s\n' "$DISPLAY_ALL" | grep -iE 'refreshRate|refresh rate|active.*mode|current.*mode' 2>/dev/null | grep -oE '[0-9]+([.][0-9]+)?[[:space:]]*Hz' 2>/dev/null | head -n 1 | sed 's/[[:space:]]*Hz//')"
    [ -n "$CURRENT" ] && printf '%s Hz' "$CURRENT" || printf '%s' UNAVAILABLE
}

parse_refresh_rates() {
    RATES="$(printf '%s\n' "$DISPLAY_ALL" | grep -oE '[0-9]+([.][0-9]+)?[[:space:]]*Hz' 2>/dev/null | sed 's/[[:space:]]*Hz//' | awk '!seen[$0]++' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    [ -n "$RATES" ] || RATES=UNAVAILABLE
    printf '%s' "$RATES"
}

parse_modes() {
    MODES="$(printf '%s\n' "$DISPLAY_ALL" | grep -oiE '[0-9]{3,5}x[0-9]{3,5}' 2>/dev/null | awk '!seen[$0]++' | tr '\n' ';' | sed 's/;$//')"
    [ -n "$MODES" ] || MODES=UNKNOWN
    printf '%s' "$MODES"
}

collect() {
    DISPLAY_SOURCE="$(source_output display 2>/dev/null || :)"
    SURFACE_SOURCE="$(source_output surfaceflinger 2>/dev/null || :)"
    SIZE_SOURCE="$(source_output size 2>/dev/null || :)"
    DENSITY_SOURCE="$(source_output density 2>/dev/null || :)"
    REFRESH_SOURCE="$(source_output refresh 2>/dev/null || :)"
    DISPLAY_ALL="$(printf '%s\n%s\n%s\n%s\n%s\n' "$DISPLAY_SOURCE" "$SURFACE_SOURCE" "$SIZE_SOURCE" "$DENSITY_SOURCE" "$REFRESH_SOURCE")"
    RESOLUTION="$(parse_resolution)"; [ -n "$RESOLUTION" ] || RESOLUTION=UNAVAILABLE
    DENSITY="$(parse_density)"; [ -n "$DENSITY" ] || DENSITY=UNAVAILABLE
    DISPLAY_ID="$(parse_id)"
    CURRENT_REFRESH="$(parse_refresh_current)"
    SUPPORTED_REFRESH="$(parse_refresh_rates)"
    DISPLAY_MODES="$(parse_modes)"
    if printf '%s\n' "$DISPLAY_ALL" | grep -qiE 'hdr10|hdr[[:space:]]*capab|hdr supported'; then HDR=SUPPORTED; elif [ -n "$DISPLAY_ALL" ]; then HDR=UNKNOWN; else HDR=UNAVAILABLE; fi
    ACTIVE_MODE="$(printf '%s\n' "$DISPLAY_ALL" | grep -iE 'active.*mode|current.*mode|modeId|mActiveMode' 2>/dev/null | head -n 1 | sed 's/^[[:space:]]*//')"
    [ -n "$ACTIVE_MODE" ] || ACTIVE_MODE=UNKNOWN
}

status() {
    collect
    echo 'AX-T615 DISPLAY STATUS'
    echo '====================='
    echo
    echo "Display ID: $DISPLAY_ID"
    echo "Resolution: $RESOLUTION"
    echo "Logical display size: $RESOLUTION"
    echo "Density: $DENSITY"
    echo "Refresh rate: $CURRENT_REFRESH"
    echo "Supported refresh rates: $SUPPORTED_REFRESH"
    echo "Active display mode: $ACTIVE_MODE"
    echo "HDR: $HDR"
    echo
    echo 'Read-only: display settings were not changed.'
    display_log INFO "status id=$DISPLAY_ID resolution=$RESOLUTION refresh=$CURRENT_REFRESH modes=$DISPLAY_MODES"
}

inspect() {
    collect
    echo 'AX-T615 DISPLAY INSPECTION (READ-ONLY)'
    echo '======================================='
    echo "Data root: $DATA_ROOT"
    echo "Display ID: $DISPLAY_ID"
    echo "Resolution: $RESOLUTION"
    echo "Density: $DENSITY"
    echo "Current refresh rate: $CURRENT_REFRESH"
    echo "Supported refresh rates: $SUPPORTED_REFRESH"
    echo "Supported display modes: $DISPLAY_MODES"
    echo "Active display mode: $ACTIVE_MODE"
    echo "HDR capability: $HDR"
    echo
    echo 'Sources: dumpsys display, SurfaceFlinger, wm size, wm density, and read-only settings where available.'
    echo 'No display, SurfaceFlinger, compositor, property, /proc, or /sys settings were modified.'
    display_log INFO "inspect id=$DISPLAY_ID resolution=$RESOLUTION refresh=$CURRENT_REFRESH"
}

refresh() { collect; echo "Refresh rate: $CURRENT_REFRESH"; echo "Supported refresh rates: $SUPPORTED_REFRESH"; echo 'Refresh rate was not changed.'; }
modes() { collect; echo "Resolution: $RESOLUTION"; echo "Active display mode: $ACTIVE_MODE"; echo "Supported display modes: $DISPLAY_MODES"; echo "Supported refresh rates: $SUPPORTED_REFRESH"; echo 'Display modes were not changed.'; }

case "${1:-status}" in
    status) [ "$#" -eq 1 ] || exit 2; status ;;
    inspect) [ "$#" -eq 1 ] || exit 2; inspect ;;
    refresh) [ "$#" -eq 1 ] || exit 2; refresh ;;
    modes) [ "$#" -eq 1 ] || exit 2; modes ;;
    *) echo 'Usage: display-controller status|inspect|refresh|modes' >&2; exit 2 ;;
esac
